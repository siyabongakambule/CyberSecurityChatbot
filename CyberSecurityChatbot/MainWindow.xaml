<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=" Cybersecurity Awareness Bot — South Africa"
        Height="750" Width="1050"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#070D1A"
        FontFamily="Consolas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0 — HEADER with ASCII art logo -->
        <Border Grid.Row="0" Background="#0D1830"
                BorderBrush="#00DDDD" BorderThickness="0,0,0,2"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontFamily="Consolas" FontSize="7.5"
                               Foreground="#00DDDD" FontWeight="Bold"
                               xml:space="preserve">  ██████╗██╗   ██╗██████╗ ███████╗██████╗     ██████╗  ██████╗ ████████╗
 ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗    ██╔══██╗██╔═══██╗╚══██╔══╝
 ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝    ██████╔╝██║   ██║   ██║   
 ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗    ██╔══██╗██║   ██║   ██║   
 ╚██████╗   ██║   ██████╔╝███████╗██║  ██║    ██████╔╝╚██████╔╝   ██║   
  ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝    ╚═════╝  ╚═════╝    ╚═╝</TextBlock>

                    <TextBlock FontFamily="Consolas" FontSize="11"
                               Foreground="#00E676" FontWeight="Bold"
                               Margin="0,4,0,0">
                          CYBERSECURITY AWARENESS ASSISTANT    Department of Cybersecurity    South Africa  🇿🇦
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           FontFamily="Consolas" FontSize="9"
                           Foreground="#FFD740"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           xml:space="preserve">  /\_____/\
 /  o   o  \
( ==  ^  == )
 )         (
(  (     )  )
(__(_____)__)</TextBlock>
            </Grid>
        </Border>

        <!-- ROW 1 — Quick topic buttons -->
        <Border Grid.Row="1" Background="#111F3A"
                BorderBrush="#1A3060" BorderThickness="0,0,0,1"
                Padding="10,6">
            <WrapPanel Orientation="Horizontal">
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="phishing" Click="TopicButton_Click"> Phishing</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="password" Click="TopicButton_Click"> Password</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="privacy" Click="TopicButton_Click"> Privacy</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="scam" Click="TopicButton_Click"> Scam</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="malware" Click="TopicButton_Click"> Malware</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="browsing" Click="TopicButton_Click"> Browsing</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="2fa" Click="TopicButton_Click"> 2FA</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="give me another tip" Click="TopicButton_Click"> Another Tip</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Tag="help" Click="TopicButton_Click"> Help</Button>
                <Button Style="{StaticResource CyberButton}" Margin="3,2"
                        Background="#1A0A0A" BorderBrush="#FF5252" Foreground="#FF5252"
                        Click="ClearButton_Click"> Clear</Button>
            </WrapPanel>
        </Border>

        <!-- ROW 2 — Chat display -->
        <ScrollViewer Grid.Row="2"
                      x:Name="ChatScrollViewer"
                      Background="#070D1A"
                      VerticalScrollBarVisibility="Auto"
                      Padding="12,8">
            <StackPanel x:Name="ChatPanel" Margin="4,0"/>
        </ScrollViewer>

        <!-- ROW 3 — Memory status bar -->
        <Border Grid.Row="3" Background="#0A1228"
                BorderBrush="#1A3060" BorderThickness="0,1,0,0"
                Padding="12,4">
            <TextBlock x:Name="MemoryBar"
                       FontFamily="Consolas" FontSize="9"
                       Foreground="#5A6A8A"
                       Text="💾  Memory — Name: —  |  Favourite topic: None  |  Last topic: None"/>
        </Border>

        <!-- ROW 4 — Input area -->
        <Border Grid.Row="4" Background="#0D1830"
                BorderBrush="#00DDDD" BorderThickness="0,2,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Style="{StaticResource CyberTextBox}"
                         Height="42"
                         Margin="0,0,10,0"
                         KeyDown="InputBox_KeyDown"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        Style="{StaticResource SendButton}"
                        Width="100" Height="42"
                        Click="SendButton_Click">
                    SEND  ▶
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
