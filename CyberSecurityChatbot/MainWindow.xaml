<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=" Cybersecurity Awareness Bot "
        Height="800" Width="1100"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#070D1A"
        FontFamily="Consolas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0D1830"
                BorderBrush="#00DDDD" BorderThickness="0,0,0,2"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontFamily="Consolas" FontSize="7"
                               Foreground="#00DDDD" FontWeight="Bold"
                               xml:space="preserve">  ██████╗██╗   ██╗██████╗ ███████╗██████╗     ██████╗  ██████╗ ████████╗
 ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗    ██╔══██╗██╔═══██╗╚══██╔══╝
 ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝    ██████╔╝██║   ██║   ██║   
 ╚██████╗   ██║   ██████╔╝███████╗██║  ██║    ██████╔╝╚██████╔╝   ██║   
  ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝    ╚═════╝  ╚═════╝    ╚═╝</TextBlock>
                    <TextBlock FontFamily="Consolas" FontSize="10"
                               Foreground="#00E676" FontWeight="Bold"
                               Margin="0,2,0,0">
                          CYBERSECURITY AWARENESS ASSISTANT  |  Department of Cybersecurity  |  South Africa  🇿🇦
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           FontFamily="Consolas" FontSize="8"
                           Foreground="#FFD740"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           xml:space="preserve">  /\_____/\
 /  o   o  \
( ==  ^  == )
 )         (
(__(_____)__)</TextBlock>
            </Grid>
        </Border>

        <!-- MAIN TAB CONTROL -->
        <TabControl Grid.Row="1"
                    Background="#070D1A"
                    BorderBrush="#1A3060"
                    Foreground="#DCE6FF">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background"  Value="#0D1830"/>
                    <Setter Property="Foreground"  Value="#5A6A8A"/>
                    <Setter Property="FontFamily"  Value="Consolas"/>
                    <Setter Property="FontSize"    Value="12"/>
                    <Setter Property="Padding"     Value="16,8"/>
                    <Setter Property="BorderBrush" Value="#1A3060"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#070D1A"/>
                            <Setter Property="Foreground" Value="#00DDDD"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#DCE6FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1 — CHAT -->
            <TabItem Header="  Chat">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Quick buttons -->
                    <Border Grid.Row="0" Background="#111F3A"
                            BorderBrush="#1A3060" BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <WrapPanel>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="phishing" Click="TopicButton_Click"> Phishing</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="password" Click="TopicButton_Click"> Password</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="privacy" Click="TopicButton_Click"> Privacy</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="scam" Click="TopicButton_Click"> Scam</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="malware" Click="TopicButton_Click"> Malware</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="browsing" Click="TopicButton_Click"> Browsing</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="2fa" Click="TopicButton_Click"> 2FA</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="start quiz" Click="TopicButton_Click"> Quiz</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="view tasks" Click="TopicButton_Click"> Tasks</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="show activity log" Click="TopicButton_Click"> Activity Log</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Tag="give me another tip" Click="TopicButton_Click"> Another Tip</Button>
                            <Button Style="{StaticResource CyberButton}" Margin="2"
                                    Background="#1A0A0A" BorderBrush="#FF5252"
                                    Foreground="#FF5252"
                                    Click="ClearButton_Click"> Clear</Button>
                        </WrapPanel>
                    </Border>

                    <!-- Chat display -->
                    <ScrollViewer Grid.Row="1"
                                  x:Name="ChatScrollViewer"
                                  Background="#070D1A"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10,6">
                        <StackPanel x:Name="ChatPanel" Margin="4,0"/>
                    </ScrollViewer>

                    <!-- Memory bar -->
                    <Border Grid.Row="2" Background="#0A1228"
                            BorderBrush="#1A3060" BorderThickness="0,1,0,0"
                            Padding="10,4">
                        <TextBlock x:Name="MemoryBar"
                                   FontFamily="Consolas" FontSize="9"
                                   Foreground="#5A6A8A"
                                   Text="  Memory — Name: —  |  Favourite topic: None  |  Last topic: None"/>
                    </Border>

                    <!-- Input area -->
                    <Border Grid.Row="3" Background="#0D1830"
                            BorderBrush="#00DDDD" BorderThickness="0,2,0,0"
                            Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="InputBox"
                                     Style="{StaticResource CyberTextBox}"
                                     Height="40" Margin="0,0,8,0"
                                     KeyDown="InputBox_KeyDown"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SendButton}"
                                    Width="90" Height="40"
                                    Click="SendButton_Click">SEND </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2 — TASKS -->
            <TabItem Header="  Tasks">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Add task form -->
                    <Border Grid.Row="0" Background="#0D1830"
                            BorderBrush="#00DDDD" BorderThickness="1"
                            CornerRadius="6" Padding="14,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="  ADD A NEW CYBERSECURITY TASK"
                                       Foreground="#00DDDD" FontSize="12"
                                       FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Task Title:"
                                       Foreground="#DCE6FF" FontSize="10"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="TaskTitleBox"
                                     Style="{StaticResource CyberTextBox}"
                                     Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Description (optional):"
                                       Foreground="#DCE6FF" FontSize="10"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="TaskDescBox"
                                     Style="{StaticResource CyberTextBox}"
                                     Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Reminder Date (optional):"
                                       Foreground="#DCE6FF" FontSize="10"
                                       Margin="0,0,0,4"/>
                            <DatePicker x:Name="ReminderDatePicker"
                                        Background="#0A1220"
                                        Foreground="#FFD740"
                                        BorderBrush="#1A3060"
                                        Height="34" Margin="0,0,0,10"/>

                            <Button Style="{StaticResource SendButton}"
                                    Height="36"
                                    Click="AddTaskButton_Click">
                                  ADD TASK
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Task action buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Style="{StaticResource CyberButton}"
                                Margin="0,0,6,0"
                                Click="ViewTasksButton_Click"> View All Tasks</Button>
                        <Button Style="{StaticResource CyberButton}"
                                Margin="0,0,6,0"
                                Background="#0A2A0A"
                                BorderBrush="#00E676"
                                Foreground="#00E676"
                                Click="CompleteTaskButton_Click"> Complete Task</Button>
                        <Button Style="{StaticResource CyberButton}"
                                Background="#1A0A0A"
                                BorderBrush="#FF5252"
                                Foreground="#FF5252"
                                Click="DeleteTaskButton_Click"> Delete Task</Button>
                        <TextBox x:Name="TaskIdBox"
                                 Style="{StaticResource CyberTextBox}"
                                 Width="80" Height="28"
                                 Margin="8,0,0,0"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="← Task ID"
                                   Foreground="#5A6A8A" FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Task display -->
                    <Border Grid.Row="2" Background="#0D1830"
                            BorderBrush="#1A3060" BorderThickness="1"
                            CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TaskDisplay"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#00DDB4"
                                       TextWrapping="Wrap"
                                       Text="Your tasks will appear here. Click 'View All Tasks' to load them."/>
                        </ScrollViewer>
                    </Border>

                    <!-- Task status -->
                    <TextBlock Grid.Row="3"
                               x:Name="TaskStatusBar"
                               Foreground="#5A6A8A" FontSize="9"
                               Margin="0,6,0,0"
                               Text="  Use the form above to add tasks or type commands in the Chat tab."/>
                </Grid>
            </TabItem>

            <!-- TAB 3 — QUIZ -->
            <TabItem Header="  Quiz">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Quiz header -->
                    <Border Grid.Row="0" Background="#0D1830"
                            BorderBrush="#FFD740" BorderThickness="0,0,0,2"
                            Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="  CYBERSECURITY QUIZ"
                                       Foreground="#FFD740" FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Test your cybersecurity knowledge with 10 questions!"
                                       Foreground="#5A6A8A" FontSize="10"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Quiz display -->
                    <Border Grid.Row="1" Background="#0D1830"
                            BorderBrush="#1A3060" BorderThickness="1"
                            CornerRadius="6" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="QuizDisplay"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#DCE6FF"
                                       TextWrapping="Wrap"
                                       Text="Click 'Start Quiz' to begin!"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Quiz controls -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SendButton}"
                                Width="140" Height="40"
                                Click="StartQuizButton_Click"> Start Quiz</Button>

                        <TextBox Grid.Column="1"
                                 x:Name="QuizAnswerBox"
                                 Style="{StaticResource CyberTextBox}"
                                 Height="40" Margin="10,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="QuizAnswerBox_KeyDown"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource CyberButton}"
                                Width="130" Height="40"
                                Click="SubmitAnswerButton_Click">Submit Answer ▶</Button>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 4 — ACTIVITY LOG -->
            <TabItem Header="  Activity Log">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Log header -->
                    <Border Grid.Row="0" Background="#0D1830"
                            BorderBrush="#00E676" BorderThickness="0,0,0,2"
                            Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="  ACTIVITY LOG"
                                       Foreground="#00E676" FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="A full record of all actions taken during this session."
                                       Foreground="#5A6A8A" FontSize="10"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Log display -->
                    <Border Grid.Row="1" Background="#0D1830"
                            BorderBrush="#1A3060" BorderThickness="1"
                            CornerRadius="6" Padding="14">
                        <ScrollViewer x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogDisplay"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#00E676"
                                       TextWrapping="Wrap"
                                       Text="No activity recorded yet."/>
                        </ScrollViewer>
                    </Border>

                    <!-- Refresh button -->
                    <Button Grid.Row="2"
                            Style="{StaticResource CyberButton}"
                            Height="36" Margin="0,10,0,0"
                            Click="RefreshLogButton_Click"> Refresh Activity Log</Button>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>