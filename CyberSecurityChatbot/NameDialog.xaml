<Window x:Class="CybersecurityChatbot.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="480" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#070D1A"
        FontFamily="Consolas">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII Robot mascot -->
        <TextBlock Grid.Row="0"
                   FontFamily="Consolas" FontSize="11"
                   Foreground="#FFD740"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   xml:space="preserve">         /\_____/\
        /  o   o  \
       ( ==  ^  == )        Stay Safe Online
        )         (
       (  (     )  )
      ( __(_____)__ )</TextBlock>

        <!-- Title -->
        <TextBlock Grid.Row="1"
                   Text="🛡️  CYBERSECURITY AWARENESS BOT"
                   FontSize="16" FontWeight="Bold"
                   Foreground="#00E676"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>

        <!-- Subtitle -->
        <TextBlock Grid.Row="2"
                   Text="Department of Cybersecurity — South Africa"
                   FontSize="10"
                   Foreground="#5A6A8A"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- Divider -->
        <TextBlock Grid.Row="3"
                   FontFamily="Consolas" FontSize="9"
                   Foreground="#00DDDD"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"
                   Text="══════════════════════════════════════════════════════"/>

        <!-- Name prompt -->
        <TextBlock Grid.Row="4"
                   Text="👤  Please enter your name to get started:"
                   FontSize="12"
                   Foreground="#DCE6FF"
                   Margin="0,0,0,8"/>

        <!-- Name input + error message -->
        <Grid Grid.Row="5" Margin="0,0,0,16">
            <TextBox x:Name="NameBox"
                     Height="40"
                     Background="#0A1220"
                     Foreground="#FFD740"
                     CaretBrush="#FFD740"
                     FontSize="14"
                     Padding="10,6"
                     BorderBrush="#00DDDD"
                     BorderThickness="1"
                     KeyDown="NameBox_KeyDown"/>
            <TextBlock x:Name="ErrorText"
                       Foreground="#FF5252"
                       FontSize="10"
                       Margin="0,46,0,0"
                       Visibility="Collapsed"
                       Text="⚠️  Name cannot be empty. Please enter your name."/>
        </Grid>

        <!-- Start button -->
        <Button Grid.Row="6"
                x:Name="StartBtn"
                Content="START CHATTING  ▶"
                Height="44"
                Background="#00E676"
                Foreground="#070D1A"
                FontSize="13"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="StartBtn_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="16,8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#00FF8A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#00C853"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>
