<Application x:Class="CybersecurityChatbot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ── Global Colour Palette ── -->
        <SolidColorBrush x:Key="BgDark"       Color="#070D1A"/>
        <SolidColorBrush x:Key="BgMid"        Color="#0D1830"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#111F3A"/>
        <SolidColorBrush x:Key="BgInput"      Color="#0A1220"/>
        <SolidColorBrush x:Key="AccentCyan"   Color="#00DDDD"/>
        <SolidColorBrush x:Key="AccentGreen"  Color="#00E676"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFD740"/>
        <SolidColorBrush x:Key="AccentRed"    Color="#FF5252"/>
        <SolidColorBrush x:Key="TextWhite"    Color="#DCE6FF"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#5A6A8A"/>
        <SolidColorBrush x:Key="BotBubble"    Color="#0A2040"/>
        <SolidColorBrush x:Key="UserBubble"   Color="#0A3020"/>

        <!-- ── Button Style ── -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background"      Value="#0D1830"/>
            <Setter Property="Foreground"      Value="#00DDDD"/>
            <Setter Property="BorderBrush"     Value="#00DDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00DDDD"/>
                                <Setter Property="Foreground" Value="#070D1A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00AAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Send Button Style ── -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Background"      Value="#00E676"/>
            <Setter Property="Foreground"      Value="#070D1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00FF8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00C853"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox Style ── -->
        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#0A1220"/>
            <Setter Property="Foreground"      Value="#FFD740"/>
            <Setter Property="CaretBrush"      Value="#FFD740"/>
            <Setter Property="BorderBrush"     Value="#1A3060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00DDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
